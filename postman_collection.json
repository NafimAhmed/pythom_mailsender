{
  "info": {
    "name": "Microsoft 365 Graph Mail Sender API",
    "description": "Microsoft Graph OAuth2 app-only sender, authenticated by X-API-Key. Configure credentials in server .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Send Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": [\n    \"recipient@example.com\"\n  ],\n  \"subject\": \"Microsoft 365 Graph Test\",\n  \"body\": \"Hello from Microsoft Graph\",\n  \"html\": \"<h2>Hello</h2><p>Microsoft 365 Graph test</p>\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/mail/send",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "mail",
            "send"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "api_key",
      "value": "REPLACE_WITH_YOUR_KEY"
    }
  ]
}
