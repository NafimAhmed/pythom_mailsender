# Microsoft 365 Graph OAuth2 only (no Gmail SMTP in this branch)
# Generate MAIL_API_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAIL_API_KEY=REPLACE_WITH_RANDOM_SECRET
MS_TENANT_ID=YOUR_MICROSOFT_TENANT_GUID
MS_CLIENT_ID=YOUR_ENTRA_APP_CLIENT_GUID
MS_CLIENT_SECRET=YOUR_ENTRA_CLIENT_SECRET_VALUE
MS_SENDER_EMAIL=authorized@company.com
PORT=5001
