# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAIL_API_KEY=REPLACE_WITH_RANDOM_SECRET
MAIL_PROVIDER=smtp  # Set to graph to use Microsoft 365 Graph API

# Gmail SMTP example (or configure another SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your_email@gmail.com
PORT=5000

# Graph API app-only mode: configure only when MAIL_PROVIDER=graph
# Requires app registration, Mail.Send application permission and admin consent.
# MS_TENANT_ID=YOUR_TENANT_GUID
# MS_CLIENT_ID=YOUR_APP_CLIENT_GUID
# MS_CLIENT_SECRET=YOUR_APP_CLIENT_SECRET
# MS_SENDER_EMAIL=mailbox@company.com
